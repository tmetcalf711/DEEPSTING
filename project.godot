; Engine configuration file.
; Input bindings are intentionally NOT defined here: see scripts/systems/input_bindings.gd (DESIGN.md D12).

config_version=5

[application]

config/name="DeepSting"
config/description="Top-down 2.5D roguelite twin-stick shooter. Stung too deep."
config/version="0.3.0-m3"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="DeepSting"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

Events="*res://scripts/autoload/events.gd"
RNG="*res://scripts/autoload/rng.gd"
Platform="*res://scripts/autoload/platform.gd"
MetaSave="*res://scripts/autoload/meta_save.gd"
Content="*res://scripts/autoload/content.gd"
Art="*res://scripts/autoload/art.gd"
Audio="*res://scripts/autoload/audio.gd"
GameState="*res://scripts/autoload/game_state.gd"
RunState="*res://scripts/autoload/run_state.gd"
DebugConsole="*res://scripts/autoload/debug_console.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.05, 1)
